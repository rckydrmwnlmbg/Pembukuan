# Kasdapur — Contoh Variabel Lingkungan (Tanpa Nilai Rahasia)
# Salin ke .env.local untuk pengembangan lokal. DILARANG melakukan commit berkas .env.local!

# Publik (aman di klien HANYA karena RLS aktif di seluruh tabel — SECURITY.md S-02 & S-04)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO=false

# Rahasia Server (DILARANG diberi awalan NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Kunci enkripsi AES-256-GCM (32 byte dalam base64) & HMAC pencarian terpisah (32 byte dalam base64)
FIELD_ENCRYPTION_KEY=
FIELD_HASH_KEY=

# Rate limiting (Upstash Redis — SECURITY.md S-09)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Ekstraksi AI (OpenAI-Compatible endpoint atau Anthropic — SECURITY.md S-14 & TECH-STACK.md Bagian 4)
EXTRACTION_MODE=ai
AI_BASE_URL=
AI_API_KEY=
LLM_MODEL=deepseek-v4.1-flash
ANTHROPIC_API_KEY=
EXTRACTION_DAILY_LIMIT=200

# Lingkungan aplikasi (local | demo | production)
APP_ENV=local

# Pemantauan galat opsional (SECURITY.md S-12)
SENTRY_DSN=
